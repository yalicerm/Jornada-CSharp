<Window x:Class="WpfAgendaUsandoBD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAgendaUsandoBD"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="0,10,-35,0">
        <Button x:Name="buttonSalvar" Content="Salvar Contato" HorizontalAlignment="Left" Margin="173,312,0,0" VerticalAlignment="Top" Height="25" Width="96" Click="buttonSalvar_Click"/>
        <Label x:Name="labelNome" Content="Nome:" HorizontalAlignment="Left" Margin="40,106,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label x:Name="labelTel" Content="Tel:" HorizontalAlignment="Left" Margin="44,168,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label x:Name="labelEmail" Content="Email:" HorizontalAlignment="Left" Margin="44,223,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <TextBox x:Name="textNome" HorizontalAlignment="Left" Margin="90,110,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="244"/>
        <TextBox x:Name="textTel" HorizontalAlignment="Left" Margin="90,172,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="244"/>
        <TextBox x:Name="textEmail" HorizontalAlignment="Left" Margin="93,231,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="244"/>
        <Label x:Name="centerText" Content="Agenda" HorizontalAlignment="Left" Margin="173,28,0,0" VerticalAlignment="Top" FontSize="20" FontFamily="Bahnschrift SemiBold"/>
        <Button x:Name="buttonVisualizar" Content="Visualizar Agenda" HorizontalAlignment="Left" Margin="654,375,0,0" VerticalAlignment="Top" Click="buttonVisualizar_Click"/>
        <Label Content="Insira o tel" HorizontalAlignment="Left" Margin="409,93,0,0" VerticalAlignment="Top"/>
        <ListView x:Name="listaBusca" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="436,131,73,95">
            <ListView.View>
                <GridView>
                    <GridViewColumn/>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBox x:Name="textBusca" HorizontalAlignment="Left" Margin="479,97,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="204"/>
        <Button x:Name="buttonBuscar" Content="Buscar" HorizontalAlignment="Left" Margin="688,97,0,0" VerticalAlignment="Top" Width="74" Click="buttonBuscar_Click"/>

    </Grid>
</Window>
